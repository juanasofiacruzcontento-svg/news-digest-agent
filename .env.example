# ── Cervello AI: serve almeno UNA chiave (tutte gratis, senza carta di credito) ──
GROQ_API_KEY=        # https://console.groq.com/keys
GEMINI_API_KEY=      # https://aistudio.google.com/apikey
OPENROUTER_API_KEY=  # https://openrouter.ai/keys

# ── Telegram (opzionale) ──
TELEGRAM_BOT_TOKEN=  # lo dà @BotFather su Telegram
TELEGRAM_CHAT_ID=    # il tuo ID: scrivi a @userinfobot

# ── Email (opzionale, esempio con Gmail) ──
EMAIL_USER=          # tuoindirizzo@gmail.com
EMAIL_PASSWORD=      # "password per le app" di Google, NON la tua password normale
EMAIL_TO=            # dove ricevere il notiziario
# EMAIL_SMTP=smtp.gmail.com

# ── Modelli (cambiali se uno non è più gratuito) ──
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
